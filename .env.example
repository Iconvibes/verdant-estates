# ─── Supabase (REQUIRED) ────────────────────────────────────────────────
# 1. Create a free project at https://app.supabase.com
# 2. Go to Settings → API to find your URL and anon key
# 3. Run the SQL migration in SQL Editor
# 4. Create admin user in Authentication → Users
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON=your-anon-key-here

# Mapbox — get yours at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_token_here

# ─── Deployment Notes ──────────────────────────────────────────────────
#
# Frontend (Vercel):
#   Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON as env vars
#
# Admin login:
#   Email: admin@verdantestates.ng
#   Password: Admin@123
#   (Created in Supabase Dashboard → Authentication → Users)
# ───────────────────────────────────────────────────────────────────────
