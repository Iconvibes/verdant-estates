[TEMPLATE]
# Mapbox — get yours at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=pk.your_token_here

# API URL — leave empty for Vercel (uses relative /api path)
VITE_API_URL=

# ─── Upstash Redis (persistent storage) ────────────────────────────────────
# Get free credentials from https://console.upstash.com
# Or from Vercel Marketplace → Upstash Redis integration
# Leave empty for local dev (in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server (required in production)
JWT_SECRET=change_me_in_production
NODE_ENV=development

# CORS origin — set to your Vercel deployment URL in production
# Example: CORS_ORIGIN=https://your-project.vercel.app
CORS_ORIGIN=

# ─── Vercel Deployment Notes ───────────────────────────────────────────────
#
# 1. Create an Upstash Redis database:
#    - Go to https://console.upstash.com or install the Upstash integration
#      from the Vercel Marketplace
#    - Copy the REST URL and Token
#
# 2. Set environment variables in Vercel dashboard → Settings → Environment Variables:
#    - UPSTASH_REDIS_REST_URL: your Redis REST URL
#    - UPSTASH_REDIS_REST_TOKEN: your Redis REST token
#    - JWT_SECRET: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#    - NODE_ENV: production
#    - CORS_ORIGIN: your Vercel deployment URL
#
# 3. First-time admin login:
#    - Email: admin@verdantestates.ng
#    - Password: Admin@123
#    - You will be forced to change the password on first login
#
# 4. Data persistence:
#    - With Redis credentials: data persists across cold starts
#    - Without Redis: in-memory storage (resets on cold start)
#    - Data seeds automatically on first request
#
# ───────────────────────────────────────────────────────────────────────────
